# Build
target/
*.class

# Local database - regenerated on every run, never shared
*.db
*.db-journal
*.db-wal
*.db-shm

# Generated digests are local output, not source
/digests/

# Secrets. The Google service-account key must never enter this repo.
config/*.json
**/config/*.json
.env
*.pem

# Editors / OS
.idea/
*.iml
.vscode/
.DS_Store

# Captured raw API responses. Useful locally for replay and debugging; copy one
# into src/test/resources/fixtures/ when you need it as a test fixture.
/fixtures/

# Personal data. The real profile lives in ~/.config/job-radar/applicant.yml and
# is imported from there; applicant.example.yml is the committed skeleton. A copy
# left in the working tree by accident must not be committed - this repository is
# public and that file holds a home address and EEO answers.
applicant.yml
**/applicant.yml
!applicant.example.yml

# Prepared applications: tailored resumes, cover letters, screenshots of filled
# forms. Every one contains personal data and the contents of a real application.
/applications/

# Chromium's user-data directory, if it is ever pointed inside the repo. It holds
# live session cookies for every job board signed into.
/browser/

# Gmail OAuth client secret and the cached refresh token. The token is a live
# read credential to the applicant's mailbox.
gmail-oauth.json
gmail-tokens/

# API keys. The real file lives in ~/.config/job-radar/secrets.yml; this catches
# a copy left in the working tree by accident.
secrets.yml
**/secrets.yml
