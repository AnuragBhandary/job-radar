<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.anuragbhandary</groupId>
  <artifactId>job-radar</artifactId>
  <version>1.0.0</version>
  <name>job-radar</name>
  <description>Scheduled job-search pipeline over public ATS APIs</description>

  <properties>
    <!--
      Pinned to Java 25 deliberately. The machine also has Homebrew's JDK 26 (pulled
      in as a Maven dependency), but Spring Boot 3.5.x is not tested against 26 and
      Hibernate's bytecode generation is the usual casualty. Build with:
          JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-25.jdk/Contents/Home mvn test
    -->
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!--
      Jackson, and an auto-configured ObjectMapper bean. Not pulled in by
      spring-boot-starter on its own - it normally arrives with starter-web,
      which this project deliberately does not have.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>

    <!--
      SQLite is not a dialect Hibernate ships in core; it lives in the community
      module. Both this and sqlite-jdbc have their versions managed by the Spring
      Boot BOM (Hibernate 6.6.53.Final / sqlite-jdbc 3.49.1.0), so no explicit
      <version> here - that is what keeps the swap to PostgreSQL a config change.
    -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
    </dependency>

    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>

    <!--
      Google Sheets. The application tracker is a spreadsheet the user already
      maintains by hand, so this writes through the API rather than replacing it.
      Versions are pinned because the Spring Boot BOM does not manage them.
    -->
    <dependency>
      <groupId>com.google.apis</groupId>
      <artifactId>google-api-services-sheets</artifactId>
      <version>v4-rev20260610-2.0.0</version>
      <exclusions>
        <!-- Pulls in an old Guava listenablefuture stub that clashes on the classpath. -->
        <exclusion>
          <groupId>com.google.guava</groupId>
          <artifactId>listenablefuture</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>com.google.auth</groupId>
      <artifactId>google-auth-library-oauth2-http</artifactId>
      <version>1.52.0</version>
    </dependency>


    <!--
      Playwright drives the real application form. There is no public "submit an
      application" API on any of the six ATSs this tool reads: the read APIs are
      open, the write path is a browser session with CSRF tokens and, on some
      boards, a captcha. So the form is filled the way a person fills it.

      It earns its size twice, because the same browser renders the tailored
      resume HTML to PDF - which is why there is no LaTeX or docx dependency here.
    -->

    <!--
      Gmail, read-only, for matching replies back to applications.
      
      Unlike Sheets this cannot use the service account: a service account has no
      inbox, and reading a personal Gmail with one needs domain-wide delegation
      that a consumer account cannot grant. So this is the installed-app OAuth
      flow - one browser consent, a refresh token cached in ~/.config/job-radar -
      and google-oauth-client-jetty is what serves the localhost redirect.
    -->

    <!--
      The review UI, and the only reason there is a web layer at all. It is off
      unless the `ui` command is used: main() picks NONE for every other command,
      so fetch, screen and digest still start in under a second and never bind a
      port. See UiCommand for why a queue in a browser earned this.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>com.google.apis</groupId>
      <artifactId>google-api-services-gmail</artifactId>
      <version>v1-rev20260727-2.0.0</version>
      <exclusions>
        <exclusion>
          <groupId>com.google.guava</groupId>
          <artifactId>listenablefuture</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>com.google.oauth-client</groupId>
      <artifactId>google-oauth-client-jetty</artifactId>
      <version>1.39.0</version>
    </dependency>

    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>1.62.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            sqlite-jdbc loads a native library. On JDK 25 that is a "restricted
            method" and warns on every run; on a future JDK it will be blocked
            outright unless native access is granted explicitly.
          -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
