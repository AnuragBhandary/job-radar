<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for macOS.

  Preferred over the built-in @Scheduled on a laptop, for one reason: launchd
  reruns a StartCalendarInterval job when the machine wakes up if the scheduled
  time was missed. A long-running JVM cannot, because it was not running.

  Install:
    cp deploy/com.anuragbhandary.job-radar.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.anuragbhandary.job-radar.plist

  Check:  launchctl list | grep job-radar
  Remove: launchctl unload ~/Library/LaunchAgents/com.anuragbhandary.job-radar.plist

  No environment variables: the spreadsheet id and key path come from
  ~/.config/job-radar/secrets.yml, like every other run. Setting them here would
  override that file.

  It runs target/job-radar-1.0.0.jar, so `mvn clean` without a `package` after it
  breaks the next run. The handoff file's "Last fetch" line shows that.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anuragbhandary.job-radar</string>

    <key>ProgramArguments</key>
    <array>
        <!-- caffeinate -i keeps the Mac from idle-sleeping mid-run; a sleep
             during a fetch once left the run frozen for hours. -->
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Library/Java/JavaVirtualMachines/jdk-25.jdk/Contents/Home/bin/java</string>
        <string>-jar</string>
        <string>/Users/anuragbhandary/Coding/job-radar/target/job-radar-1.0.0.jar</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/anuragbhandary/Coding/job-radar</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/anuragbhandary/Coding/job-radar/inbox/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/anuragbhandary/Coding/job-radar/inbox/launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
